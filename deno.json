{
  "workspace": [
    "./packages/mapgen",
    "./web"
  ],
  "tasks": {
    "dev": "deno task --cwd web dev",
    "build": "deno task --cwd web build",
    "test": "deno test -P",
    "check": "deno check && deno lint && deno fmt --check"
  },
  "nodeModulesDir": "auto",
  "fmt": {
    "lineWidth": 140,
    "exclude": [
      "python/",
      "web/viewer.html",
      "web/viewer.js",
      "web/dist/",
      ".data/"
    ]
  },
  "lint": {
    "exclude": [
      "python/",
      "web/dist/",
      ".data/"
    ]
  },
  "exclude": [
    "python/",
    ".data/",
    "web/dist/"
  ]
}
